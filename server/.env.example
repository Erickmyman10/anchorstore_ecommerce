# Copy this file to .env and fill in all values before starting the server.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/anchorsoft_ecommerce

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# Admin registration code
ADMIN_AUTH_CODE=ANCHOR-ADMIN-2026-SAMUEL

# Allowed frontend origin (no trailing slash) — set to your Netlify URL in production
FRONTEND_URL=https://anchorstoremarket.netlify.app

# Paystack secret key — get from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Server port
PORT=5000

# Set to "production" in prod — controls error detail exposure
NODE_ENV=production
